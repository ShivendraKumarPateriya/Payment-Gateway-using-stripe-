# Stripe API Keys (Get from https://dashboard.stripe.com/apikeys)
STRIPE_SECRET_KEY=[PLACEHOLDER_STRIPE_SECRET_KEY]
STRIPE_WEBHOOK_SECRET=[PLACEHOLDER_STRIPE_WEBHOOK_SECRET]

# Database Configuration
# Leave empty to use SQLite (stripe_payments.db)
# For PostgreSQL: postgresql://user:password@localhost:5432/stripe_payments
# For MySQL: mysql://user:password@localhost:3306/stripe_payments
DATABASE_URL=

# Frontend Configuration
FRONTEND_BASE_URL=http://localhost:3000
FRONTEND_ORIGINS=http://localhost:3000

# Payment Defaults
DEFAULT_CURRENCY=usd
DEFAULT_PRODUCT_NAME=Demo Product
DEFAULT_AMOUNT_CENTS=1000
DEFAULT_QUANTITY=1

# Payment Limits
MAX_AMOUNT_CENTS=1000000
MAX_QUANTITY=100

# API Configuration
API_TITLE=Stripe Checkout Demo API
API_VERSION=2.0.0
